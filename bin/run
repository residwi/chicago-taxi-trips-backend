#!/usr/bin/env bash

set -e

if [ -z "$1" ]; then
    APPLICATION_PORT=8080
else
    APPLICATION_PORT=$1
fi

echo "Starting the server on port $APPLICATION_PORT"

docker run \
    -e GIN_MODE=release \
    -e PARQUET_FILE_PATH=/dataset/chicago_taxi_trips_2020.parquet \
    -e PORT="$APPLICATION_PORT" \
    -v "$(pwd)"/dataset:/dataset \
    --network=host \
    --rm \
    taxi-trips
